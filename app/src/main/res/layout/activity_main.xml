<?xml version="1.0" encoding="utf-8"?>
<!-- 首页：首次设置 / 正常工作 / 权限异常三种状态共用这一个布局，由 MainActivity 切换显隐。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="36dp"
        android:paddingBottom="28dp">

        <!-- 插画 + 标题 + 副标题 -->
        <LinearLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="14dp">

            <ImageView
                android:id="@+id/hero_image"
                android:layout_width="168dp"
                android:layout_height="126dp"
                android:importantForAccessibility="no"
                android:src="@drawable/illo_active" />

            <TextView
                android:id="@+id/hero_title"
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityHeading="true"
                android:gravity="center" />

            <TextView
                android:id="@+id/hero_sub"
                style="@style/Text.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center" />
        </LinearLayout>

        <!-- 首次设置页：卡片上方的分组小标题 -->
        <LinearLayout
            android:id="@+id/setup_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:layout_marginBottom="14dp">

            <TextView
                style="@style/Text.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/title_permissions" />

            <TextView
                android:id="@+id/setup_progress"
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 权限卡片（设计系统 PermissionGroup） -->
        <LinearLayout
            android:id="@+id/permission_card"
            style="@style/Card">

            <LinearLayout
                android:id="@+id/permission_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:paddingVertical="10dp"
                android:paddingStart="18dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/permission_header_icon"
                    style="@style/RowIcon" />

                <TextView
                    style="@style/Text.RowTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/title_permissions" />

                <TextView
                    android:id="@+id/permission_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/permission_chevron"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_round"
                    android:elevation="2dp"
                    android:importantForAccessibility="no"
                    android:outlineAmbientShadowColor="@color/shadow"
                    android:outlineSpotShadowColor="@color/shadow"
                    android:scaleType="center"
                    android:src="@drawable/ic_chevron_down" />
            </LinearLayout>

            <View
                android:id="@+id/divider_header"
                style="@style/Divider" />

            <include
                android:id="@+id/row_a11y"
                layout="@layout/item_permission" />

            <View
                android:id="@+id/divider_files"
                style="@style/Divider" />

            <include
                android:id="@+id/row_files"
                layout="@layout/item_permission" />

            <View
                android:id="@+id/divider_battery"
                style="@style/Divider" />

            <include
                android:id="@+id/row_battery"
                layout="@layout/item_permission" />
        </LinearLayout>

        <!-- 国产 ROM 提示（设计系统 Hint） -->
        <LinearLayout
            android:id="@+id/hint_card"
            style="@style/Card"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:paddingVertical="14dp">

            <ImageView
                style="@style/RowIcon"
                android:src="@drawable/ic_info" />

            <TextView
                style="@style/Text.RowSub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineHeight="20sp"
                android:text="@string/rom_hint" />
        </LinearLayout>

        <!-- 最近改名记录（设计系统 RenameLog） -->
        <LinearLayout
            android:id="@+id/log_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="14dp"
                android:accessibilityHeading="true"
                android:text="@string/title_log" />

            <LinearLayout
                android:id="@+id/log_list"
                style="@style/Card" />

            <LinearLayout
                android:id="@+id/log_empty"
                style="@style/Card"
                android:gravity="center_horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="28dp">

                <TextView
                    style="@style/Text.RowTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/log_empty" />

                <TextView
                    style="@style/Text.RowSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/log_empty_sub" />
            </LinearLayout>
        </LinearLayout>

        <!-- 首次设置页底部的隐私承诺 -->
        <Space
            android:id="@+id/privacy_space"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <TextView
            android:id="@+id/privacy"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:text="@string/privacy" />
    </LinearLayout>
</ScrollView>
